# Rendered by `make deploy-staging-env` from deploy/staging/exporter.export.env.in
# and deploy/staging/universe-imoex-ofz.txt. Do not edit on the host.
#
# Секретов здесь нет: TC_LOGIN, TC_PASSWORD и CLICKHOUSE_URL лежат в
# /etc/transaq-clickhouse-exporter.env (600, создаёт владелец).
TC_HOST=tr1.finam.ru
TC_PORT=3900
TC_TARGET=127.0.0.1:50051
# Доски: акции TQBR и ОФЗ TQOB. Список кодов ниже фильтрует подписку по seccode.
EXPORT_SEC_BOARDS=TQBR,TQOB
# Вселенная: IMOEX + ОФЗ TQOB, 105 кодов (make universe-refresh).
EXPORT_ALL_TRADES=__EXPORT_ALL_TRADES__
# sec_info по всем облигациям — вход импортёра ofz_issue_analytics в проекте.
EXPORT_SEC_INFO_NAMES=ALL
# EXPORT_SEC_CODES намеренно пуст: подписки quotations и истории свечей нет (L2 вне scope).
LOG_LEVEL=INFO
